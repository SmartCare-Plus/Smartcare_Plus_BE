# SMARTCARE+ Backend Environment Variables
# ==========================================

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=service-account.json
FIREBASE_PROJECT_ID=smartcare-plus-c9617

# Application Settings
APP_NAME=SMARTCARE+
DEBUG=True

# Local Storage (since we're not using Cloud Storage)
LOCAL_MEDIA_PATH=media

# CORS Origins (add Flutter app origin when running on device)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://10.0.2.2:8000"]

# WebSocket Settings
WS_MAX_CONNECTIONS=100
WS_HEARTBEAT_INTERVAL=30

# Thread Pool for Video Processing
THREAD_POOL_SIZE=4
VIDEO_FRAME_QUEUE_SIZE=100

# ML Models Path
ML_MODELS_PATH=ml_models

# Email / SMTP Configuration (Gmail App Password)
# Create app password at: https://myaccount.google.com/apppasswords
# 1. Go to Google Account > Security > 2-Step Verification (enable if not already)
# 2. Scroll to "App passwords" and generate a new one for "Mail"
SMTP_EMAIL=
SMTP_PASSWORD=

# Speech-to-text accessibility (Vertex AI Gemini)
# Uses a separate service account for STT so Firebase/Auth credentials remain unchanged.
STT_PROVIDER=vertex_ai
VERTEX_AI_CREDENTIALS_PATH=vertex_ai.json
VERTEX_AI_PROJECT_ID=smartcare-plus-495011
VERTEX_AI_LOCATION=us-central1
GEMINI_STT_MODEL=gemini-2.5-flash
STT_DEFAULT_LOCALE=en-US
STT_MAX_AUDIO_MB=8
